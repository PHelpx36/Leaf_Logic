<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background"
    tools:context=".ui.notifications.NotificationFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título grande com o nome da planta -->

        <!-- Placar de notificações -->
        <TextView
            android:id="@+id/plant_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="50dp"
            android:gravity="center"
            android:text="Nome da Planta"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- TabLayout para as abas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Notificações Pendentes -->
            <TextView
                android:id="@+id/titlePendentes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendentes:"
                android:textColor="@color/black"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/placar_pendentes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="100dp"
                android:textColor="#FAFF00"
                android:textSize="50sp" />

            <!-- Notificações Concluídas -->
            <TextView
                android:id="@+id/titleConcluidas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Concluídas:"
                android:textColor="@color/black"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/placar_concluidas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/dark_green"
                android:textSize="50sp" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="110dp"
            android:background="@color/very_light_green"
            android:contentDescription="@string/BemVindo" />

        <!-- ViewPager2 para exibir os fragmentos de cada aba -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/opacity_text"/>

    </LinearLayout>
</ScrollView>
